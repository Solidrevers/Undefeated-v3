-- ============ CORE GAME LOGIC ============

local function IsAlive(player)
    local char = player.Character
    return char and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0
end

local function GetCharacterRoot(char)
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function ApplyTheme(guiElement, color)
    if guiElement:IsA("Frame") or guiElement:IsA("TextButton") or guiElement:IsA("TextLabel") or guiElement:IsA("ScrollingFrame") then
        if guiElement.BackgroundColor3 then guiElement.BackgroundColor3 = color end
        if guiElement:FindFirstChildOfClass("UIStroke") and guiElement.UIStroke then guiElement.UIStroke.Color = color end
    end
    if guiElement:IsA("TextButton") or guiElement:IsA("TextLabel") then
        if guiElement.TextColor3 then guiElement.TextColor3 = color end
    end
    if guiElement:IsA("ScrollingFrame") then
        if guiElement.ScrollBarImageColor3 then guiElement.ScrollBarImageColor3 = color end
    end
    for _, child in ipairs(guiElement:GetChildren()) do
        ApplyTheme(child, color)
    end
end

