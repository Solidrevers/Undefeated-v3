            local dist = (myRoot.Position - theirRoot.Position).Magnitude
            if dist <= Config.StealRadius then
                -- Simplified item detection, assumes items are descendants of the character
                for _, item in pairs(player.Character:GetDescendants()) do
                    if item.Name:lower():find("brainrot") then -- Check for brainrot items
