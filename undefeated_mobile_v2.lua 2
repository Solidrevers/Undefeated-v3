local function CreateToggle(parent, name, varName, defaultValue)
    local ToggleFrame = Instance.new("Frame")
    ToggleFrame.Size = UDim2.new(1, -6, 0, 38)
    ToggleFrame.BackgroundColor3 = Color3.fromRGB(36, 36, 46)
    ToggleFrame.BorderSizePixel = 0
    ToggleFrame.LayoutOrder = 100
    ToggleFrame.Parent = parent

    local FrameCorner = Instance.new("UICorner")
    FrameCorner.CornerRadius = UDim.new(0, 6)
    FrameCorner.Parent = ToggleFrame

    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(0.65, 0, 1, 0)
    Label.Position = UDim2.new(0, 8, 0, 0)
    Label.BackgroundTransparency = 1
    Label.Text = name
    Label.TextColor3 = Color3.fromRGB(230, 230, 240)
    Label.TextScaled = true
    Label.Font = Enum.Font.Gotham
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.Parent = ToggleFrame

    local ToggleBG = Instance.new("Frame")
    ToggleBG.Size = UDim2.new(0, 52, 0, 24)
    ToggleBG.Position = UDim2.new(1, -60, 0.5, -12)
    ToggleBG.BackgroundColor3 = defaultValue and Config.ThemeColor or Color3.fromRGB(70, 70, 85)
    ToggleBG.BorderSizePixel = 0
    ToggleBG.Parent = ToggleFrame

    local BGCorner = Instance.new("UICorner")
    BGCorner.CornerRadius = UDim.new(1, 0)
    BGCorner.Parent = ToggleBG

    local Knob = Instance.new("Frame")
    Knob.Size = UDim2.new(0, 20, 0, 20)
    Knob.Position = defaultValue and UDim2.new(1, -22, 0.5, -10) or UDim2.new(0, 2, 0.5, -10)
    Knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    Knob.BorderSizePixel = 0
    Knob.ZIndex = 2
    Knob.Parent = ToggleBG

    local KnobCorner = Instance.new("UICorner")
    KnobCorner.CornerRadius = UDim.new(1, 0)
    KnobCorner.Parent = Knob

    local currentValue = defaultValue
    Config[varName] = currentValue -- Set initial value in Config table

    ToggleBG.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            currentValue = not currentValue
            Config[varName] = currentValue
            if currentValue then
                ToggleBG.BackgroundColor3 = Config.ThemeColor
                Knob.Position = UDim2.new(1, -22, 0.5, -10)
            else
                ToggleBG.BackgroundColor3 = Color3.fromRGB(70, 70, 85)
                Knob.Position = UDim2.new(0, 2, 0.5, -10)
            end
        end
    end)
end

local function CreateSlider(parent, name, varName, min, max, defaultValue)
    local SliderFrame = Instance.new("Frame")
    SliderFrame.Size = UDim2.new(1, -6, 0, 52)
    SliderFrame.BackgroundColor3 = Color3.fromRGB(36, 36, 46)
    SliderFrame.BorderSizePixel = 0
    SliderFrame.LayoutOrder = 200
    SliderFrame.Parent = parent

    local FrameCorner = Instance.new("UICorner")
    FrameCorner.CornerRadius = UDim.new(0, 6)
    FrameCorner.Parent = SliderFrame

    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(1, -12, 0, 18)
    Label.Position = UDim2.new(0, 6, 0, 4)
    Label.BackgroundTransparency = 1
    Label.Text = name .. ": " .. tostring(defaultValue)
    Label.TextColor3 = Color3.fromRGB(230, 230, 240)
    Label.TextScaled = true
    Label.Font = Enum.Font.Gotham
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.Parent = SliderFrame

    local SliderBG = Instance.new("Frame")
    SliderBG.Size = UDim2.new(1, -12, 0, 10)
    SliderBG.Position = UDim2.new(0, 6, 0, 26)
    SliderBG.BackgroundColor3 = Color3.fromRGB(55, 55, 70)
    SliderBG.BorderSizePixel = 0
    SliderBG.Parent = SliderFrame

    local SliderFill = Instance.new("Frame")
    SliderFill.Size = UDim2.new((defaultValue - min) / (max - min), 0, 1, 0)
    SliderFill.BackgroundColor3 = Config.ThemeColor
    SliderFill.BorderSizePixel = 0
    SliderFill.Parent = SliderBG

    local FillCorner = Instance.new("UICorner")
    FillCorner.CornerRadius = UDim.new(0, 5)
    FillCorner.Parent = SliderFill

    local Knob = Instance.new("Frame")
    Knob.Size = UDim2.new(0, 20, 0, 20)
    Knob.Position = UDim2.new((defaultValue - min) / (max - min), -10, 0.5, -10)
    Knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    Knob.BorderSizePixel = 0
    Knob.ZIndex = 2
    Knob.Parent = SliderBG

    local KnobCorner = Instance.new("UICorner")
    KnobCorner.CornerRadius = UDim.new(1, 0)
    KnobCorner.Parent = Knob

    local dragging = false

    local function updateSlider(input)
        local pos = math.clamp((input.Position.X - SliderBG.AbsolutePosition.X) / SliderBG.AbsoluteSize.X, 0, 1)
        local val = min + (max - min) * pos
        local roundedVal = math.floor(val)
        Config[varName] = roundedVal
        Label.Text = name .. ": " .. tostring(roundedVal)
        SliderFill.Size = UDim2.new(pos, 0, 1, 0)
        Knob.Position = UDim2.new(pos, -10, 0.5, -10)
    end

    SliderBG.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            updateSlider(input)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement) then
            updateSlider(input)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
end

