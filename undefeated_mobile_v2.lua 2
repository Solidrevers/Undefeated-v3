        elseif Config.LaggerMode then -- Assuming LaggerMode is a toggle somewhere
            currentSpeed = Config.LaggerSpeed
            if Config.LaggerCarrySpeed and Config.AutoCarry then -- Check if LaggerCarrySpeed should apply
                currentSpeed = Config.LaggerCarrySpeed
            end
        end
        Humanoid.WalkSpeed = currentSpeed
    end
end)

